VERNAC COMMAND EXTEND MetaRocq_Test_Quoter_Rel_Context_Cache CLASSIFIED AS QUERY
| [ "MetaRocq" "Test" "Quoter" "Rel" "Context" "Cache" constr(c) constr(ty) ] -> {
    let env, evm = empty_evar_map () in
    let evm, c = interp_constr_merged env evm c in
    let evm, ty = interp_constr_merged env evm ty in
    test_rel_context_dependency_cache env evm
      (EConstr.to_constr evm c) (EConstr.to_constr evm ty)
  }
END

