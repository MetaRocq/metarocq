{
	"folders": [
		{
			"path": ".."
		}
	],
	"settings": {

	// A list of arguments to send to coqtop. Use seperate elements instead of spaces to seperate each argument, especially when a flag expects another trailing argument, e.g. `["-I","./bin"]` instead of `["-I ./bin"]`
	"coqtop.args": [
		"-I", "_build/install/default/lib",

		// "-bt", // get backtraces from Rocq on errors
		"-Q", "_build/default/theories/Utils", "MetaRocq.Utils",
		"-Q", "_build/default/theories/Common", "MetaRocq.Common",
		"-Q", "_build/default/theories/Template", "MetaRocq.Template",
		"-Q", "_build/default/theories/PCUIC", "MetaRocq.PCUIC",
		"-Q", "_build/default/theories/TemplatePCUIC", "MetaRocq.TemplatePCUIC",
		"-Q", "_build/default/theories/SafeChecker", "MetaRocq.SafeChecker",
		"-Q", "_build/default/theories/SafeCheckerPlugin", "MetaRocq.SafeCheckerPlugin",
		"-Q", "_build/default/theories/Erasure", "MetaRocq.Erasure",
		"-Q", "_build/default/theories/ErasurePlugin", "MetaRocq.ErasurePlugin",
		"-Q", "_build/default/theories/Translations", "MetaRocq.Translations",
		"-Q", "_build/default/theories/Quotation", "MetaRocq.Quotation",
		"-Q", "_build/default/test-suite", "MetaRocq.TestSuite",
		"-Q", "_build/default/test-suite/plugin-demo/theories", "MetaRocq.ExtractedPluginDemo",
		"-Q", "_build/default/test-suite/loop-checking/theories", "MetaRocq.LoopChecking",
		"-Q", "_build/default/examples", "MetaRocq.Examples",
	    ],
		"vscoq.args": [
			"-I", "_build/install/default/lib",

		// "-bt", // get backtraces from Rocq on errors
		"-Q", "_build/default/theories/Utils", "MetaRocq.Utils",
		"-Q", "_build/default/theories/Common", "MetaRocq.Common",
		"-Q", "_build/default/theories/Template", "MetaRocq.Template",
		"-Q", "_build/default/theories/PCUIC", "MetaRocq.PCUIC",
		"-Q", "_build/default/theories/TemplatePCUIC", "MetaRocq.TemplatePCUIC",
		"-Q", "_build/default/theories/SafeChecker", "MetaRocq.SafeChecker",
		"-Q", "_build/default/theories/SafeCheckerPlugin", "MetaRocq.SafeCheckerPlugin",
		"-Q", "_build/default/theories/Erasure", "MetaRocq.Erasure",
		"-Q", "_build/default/theories/ErasurePlugin", "MetaRocq.ErasurePlugin",
		"-Q", "_build/default/theories/Translations", "MetaRocq.Translations",
		"-Q", "_build/default/theories/Quotation", "MetaRocq.Quotation",
		"-Q", "_build/default/test-suite", "MetaRocq.TestSuite",
		"-Q", "_build/default/test-suite/plugin-demo/theories", "MetaRocq.ExtractedPluginDemo",
		"-Q", "_build/default/examples", "MetaRocq.Examples",
	    ],
	    "coq-lsp.args": [
				"-Q",
				"_build/default/theories/Utils,MetaRocq.Utils",
				"-Q",
				"_build/default/theories/Common,MetaRocq.Common",
				"-Q",
				"_build/default/theories/Template,MetaRocq.Template",
				"-Q",
				"_build/default/theories/PCUIC,MetaRocq.PCUIC",
				"-Q",
				"_build/default/theories/TemplatePCUIC,MetaRocq.TemplatePCUIC",
				"-Q",
				"_build/default/theories/SafeChecker,MetaRocq.SafeChecker",
				"-Q",
				"_build/default/theories/SafeCheckerPlugin,MetaRocq.SafeCheckerPlugin",
				"-Q",
				"_build/default/theories/Erasure,MetaRocq.Erasure",
				"-Q",
				"_build/default/theories/ErasurePlugin,MetaRocq.ErasurePlugin",
				"-Q",
				"_build/default/theories/Translations,MetaRocq.Translations",
				"-Q",
				"_build/default/theories/Quotation,MetaRocq.Quotation",
				"-Q",
				"_build/default/test-suite,MetaRocq.TestSuite",
				"-Q",
				"_build/default/test-suite/plugin-demo/theories,MetaRocq.ExtractedPluginDemo",
				"-Q",
				"_build/default/examples,MetaRocq.Examples",
				"--ocamlpath=_build/install/default/lib"
			],
	 // When enabled, will trim trailing whitespace when saving a file.
	"files.trimTrailingWhitespace": true,
	"vscoq.path": "_opam/bin/vscoqtop",
	"coq-lsp.path": "_opam/bin/coq-lsp",
	"files.exclude": {
		"**/*.vo": true,
		"**/*.vok": true,
		"**/*.vos": true,
		"**/*.aux": true,
		"**/*.glob": true,
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/CVS": true
	},
	"coq-lsp.check_only_on_request": true,
	"coqtop.binPath": "_opam/bin",
	"coqtop.coqtopExe": "coqtop",
	"coqtop.coqidetopExe": "coqidetop",
	"vsrocq.args": [
		"-I", "_build/install/default/lib",
			// "-bt", // get backtraces from Rocq on errors
		"-R", "_build/default/theories/Utils", "MetaRocq.Utils",
		"-R", "_build/default/theories/Common", "MetaRocq.Common",
		"-R", "_build/default/theories/Template", "MetaRocq.Template",
		"-R", "_build/default/theories/PCUIC", "MetaRocq.PCUIC",
		"-R", "_build/default/theories/TemplatePCUIC", "MetaRocq.TemplatePCUIC",
		"-R", "_build/default/theories/SafeChecker", "MetaRocq.SafeChecker",
		"-R", "_build/default/theories/SafeCheckerPlugin", "MetaRocq.SafeCheckerPlugin",
		"-R", "_build/default/theories/Erasure", "MetaRocq.Erasure",
		"-R", "_build/default/theories/ErasurePlugin", "MetaRocq.ErasurePlugin",
		"-R", "_build/default/theories/Translations", "MetaRocq.Translations",
		"-R", "_build/default/theories/Quotation", "MetaRocq.Quotation",
		"-R", "_build/default/test-suite", "MetaRocq.TestSuite",
		"-R", "_build/default/test-suite/plugin-demo/theories", "MetaRocq.ExtractedPluginDemo",
		"-R", "_build/default/examples", "MetaRocq.Examples",
	],
	"cSpell.enabledFileTypes": {
		"coq": false
	},
	"coq-lsp.show_universes_on_hover": false,
	"coq-lsp.pp_type": 1,
	"coq-lsp.heatmap.enabled": true,
	"coq-lsp.goal_after_tactic": false,
	"coq-lsp.messages_follow_goal": false,
	"coq-lsp.send_perf_data": false,
	"coq-lsp.admit_on_bad_qed": false,
	"coq-lsp.max_errors": 1,
	"vsrocq.args": [
		"-I", "_build/install/default/lib",

		// "-bt", // get backtraces from Rocq on errors
		"-Q", "_build/default/theories/Utils", "MetaRocq.Utils",
		"-Q", "_build/default/theories/Common", "MetaRocq.Common",
		"-Q", "_build/default/theories/Template", "MetaRocq.Template",
		"-Q", "_build/default/theories/PCUIC", "MetaRocq.PCUIC",
		"-Q", "_build/default/theories/TemplatePCUIC", "MetaRocq.TemplatePCUIC",
		"-Q", "_build/default/theories/SafeChecker", "MetaRocq.SafeChecker",
		"-Q", "_build/default/theories/SafeCheckerPlugin", "MetaRocq.SafeCheckerPlugin",
		"-Q", "_build/default/theories/Erasure", "MetaRocq.Erasure",
		"-Q", "_build/default/theories/ErasurePlugin", "MetaRocq.ErasurePlugin",
		"-Q", "_build/default/theories/Translations", "MetaRocq.Translations",
		"-Q", "_build/default/theories/Quotation", "MetaRocq.Quotation",
		"-Q", "_build/default/test-suite", "MetaRocq.TestSuite",
		"-Q", "_build/default/test-suite/plugin-demo/theories", "MetaRocq.ExtractedPluginDemo",
		"-Q", "_build/default/examples", "MetaRocq.Examples",
	],
	"vsrocq.completion.enable": true,
  }
}
