{
	"folders": [
		{
			"path": ".."
		}
	],
	"settings": {

	// A list of arguments to send to coqtop. Use seperate elements instead of spaces to seperate each argument, especially when a flag expects another trailing argument, e.g. `["-I","./bin"]` instead of `["-I ./bin"]`
	"coqtop.args": [
		"-I", "_build/install/default/lib",

		// "-bt", // get backtraces from Rocq on errors
		"-Q", "_build/default/utils/theories", "MetaRocq.Utils",
		"-Q", "_build/default/common/theories", "MetaRocq.Common",
		"-Q", "_build/default/template-rocq/theories", "MetaRocq.Template",
		"-Q", "_build/default/pcuic", "MetaRocq.PCUIC",
		"-Q", "_build/default/template-pcuic", "MetaRocq.TemplatePCUIC",
		"-Q", "_build/default/safechecker", "MetaRocq.SafeChecker",
		"-Q", "_build/default/safechecker-plugin/theories", "MetaRocq.SafeCheckerPlugin",
		"-Q", "_build/default/erasure", "MetaRocq.Erasure",
		"-Q", "_build/default/erasure-plugin/theories", "MetaRocq.ErasurePlugin",
		"-Q", "_build/default/translations", "MetaRocq.Translations",
		"-Q", "_build/default/quotation/theories", "MetaRocq.Quotation",
		"-Q", "_build/default/test-suite", "MetaRocq.TestSuite",
		"-Q", "_build/default/test-suite/plugin-demo/theories", "MetaRocq.ExtractedPluginDemo",
		"-Q", "_build/default/test-suite/loop-checking/theories", "MetaRocq.LoopChecking",
		"-Q", "_build/default/examples", "MetaRocq.Examples",
	    ],
		"vscoq.args": [
			"-I", "_build/install/default/lib",

		// "-bt", // get backtraces from Rocq on errors
		"-Q", "_build/default/utils/theories", "MetaRocq.Utils",
		"-Q", "_build/default/common/theories", "MetaRocq.Common",
		"-Q", "_build/default/template-rocq/theories", "MetaRocq.Template",
		"-Q", "_build/default/pcuic", "MetaRocq.PCUIC",
		"-Q", "_build/default/template-pcuic", "MetaRocq.TemplatePCUIC",
		"-Q", "_build/default/safechecker", "MetaRocq.SafeChecker",
		"-Q", "_build/default/safechecker-plugin/theories", "MetaRocq.SafeCheckerPlugin",
		"-Q", "_build/default/erasure", "MetaRocq.Erasure",
		"-Q", "_build/default/erasure-plugin/theories", "MetaRocq.ErasurePlugin",
		"-Q", "_build/default/translations", "MetaRocq.Translations",
		"-Q", "_build/default/quotation/theories", "MetaRocq.Quotation",
		"-Q", "_build/default/test-suite", "MetaRocq.TestSuite",
		"-Q", "_build/default/test-suite/plugin-demo/theories", "MetaRocq.ExtractedPluginDemo",
		"-Q", "_build/default/examples", "MetaRocq.Examples",
	    ],
	    "coq-lsp.args": [
				"-Q",
				"_build/default/utils/theories,MetaRocq.Utils",
				"-Q",
				"_build/default/common/theories,MetaRocq.Common",
				"-Q",
				"_build/default/template-rocq/theories,MetaRocq.Template",
				"-Q",
				"_build/default/pcuic,MetaRocq.PCUIC",
				"-Q",
				"_build/default/template-pcuic,MetaRocq.TemplatePCUIC",
				"-Q",
				"_build/default/safechecker,MetaRocq.SafeChecker",
				"-Q",
				"_build/default/safechecker-plugin/theories,MetaRocq.SafeCheckerPlugin",
				"-Q",
				"_build/default/erasure,MetaRocq.Erasure",
				"-Q",
				"_build/default/erasure-plugin/theories,MetaRocq.ErasurePlugin",
				"-Q",
				"_build/default/translations,MetaRocq.Translations",
				"-Q",
				"_build/default/quotation/theories,MetaRocq.Quotation",
				"-Q",
				"_build/default/test-suite,MetaRocq.TestSuite",
				"-Q",
				"_build/default/test-suite/plugin-demo/theories,MetaRocq.ExtractedPluginDemo",
				"-Q",
				"_build/default/examples,MetaRocq.Examples",
				"--ocamlpath=_build/install/default/lib"
			],
	 // When enabled, will trim trailing whitespace when saving a file.
	"files.trimTrailingWhitespace": true,
	"vscoq.path": "_opam/bin/vscoqtop",
	"coq-lsp.path": "_opam/bin/coq-lsp",
	"files.exclude": {
		"**/*.vo": true,
		"**/*.vok": true,
		"**/*.vos": true,
		"**/*.aux": true,
		"**/*.glob": true,
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/CVS": true
	},
	"coq-lsp.check_only_on_request": true,
	"coqtop.binPath": "_opam/bin",
	"coqtop.coqtopExe": "coqtop",
	"coqtop.coqidetopExe": "coqidetop",
	"vsrocq.args": [
		"-I", "_build/install/default/lib",
			// "-bt", // get backtraces from Rocq on errors
		"-R", "_build/default/utils/theories", "MetaRocq.Utils",
		"-R", "_build/default/common/theories", "MetaRocq.Common",
		"-R", "_build/default/template-rocq/theories", "MetaRocq.Template",
		"-R", "_build/default/pcuic", "MetaRocq.PCUIC",
		"-R", "_build/default/template-pcuic", "MetaRocq.TemplatePCUIC",
		"-R", "_build/default/safechecker", "MetaRocq.SafeChecker",
		"-R", "_build/default/safechecker-plugin/theories", "MetaRocq.SafeCheckerPlugin",
		"-R", "_build/default/erasure", "MetaRocq.Erasure",
		"-R", "_build/default/erasure-plugin/theories", "MetaRocq.ErasurePlugin",
		"-R", "_build/default/translations", "MetaRocq.Translations",
		"-R", "_build/default/quotation/theories", "MetaRocq.Quotation",
		"-R", "_build/default/test-suite", "MetaRocq.TestSuite",
		"-R", "_build/default/test-suite/plugin-demo/theories", "MetaRocq.ExtractedPluginDemo",
		"-R", "_build/default/examples", "MetaRocq.Examples",
	],
	"cSpell.enabledFileTypes": {
		"coq": false
	},
	"coq-lsp.show_universes_on_hover": false,
	"coq-lsp.pp_type": 1,
	"coq-lsp.heatmap.enabled": true,
	"coq-lsp.goal_after_tactic": false,
	"coq-lsp.messages_follow_goal": false,
	"coq-lsp.send_perf_data": false,
	"coq-lsp.admit_on_bad_qed": false,
	"coq-lsp.max_errors": 1,
	"vsrocq.args": [
		"-I", "_build/install/default/lib",

		// "-bt", // get backtraces from Rocq on errors
		"-Q", "_build/default/utils/theories", "MetaRocq.Utils",
		"-Q", "_build/default/common/theories", "MetaRocq.Common",
		"-Q", "_build/default/template-rocq/theories", "MetaRocq.Template",
		"-Q", "_build/default/pcuic", "MetaRocq.PCUIC",
		"-Q", "_build/default/template-pcuic", "MetaRocq.TemplatePCUIC",
		"-Q", "_build/default/safechecker", "MetaRocq.SafeChecker",
		"-Q", "_build/default/safechecker-plugin/theories", "MetaRocq.SafeCheckerPlugin",
		"-Q", "_build/default/erasure", "MetaRocq.Erasure",
		"-Q", "_build/default/erasure-plugin/theories", "MetaRocq.ErasurePlugin",
		"-Q", "_build/default/translations", "MetaRocq.Translations",
		"-Q", "_build/default/quotation/theories", "MetaRocq.Quotation",
		"-Q", "_build/default/test-suite", "MetaRocq.TestSuite",
		"-Q", "_build/default/test-suite/plugin-demo/theories", "MetaRocq.ExtractedPluginDemo",
		"-Q", "_build/default/examples", "MetaRocq.Examples",
	],
	"vsrocq.completion.enable": true,
  }
}
